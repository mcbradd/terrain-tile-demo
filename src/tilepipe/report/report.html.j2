<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Terrain Tile Pipeline Demo: validation report</title>
<style>
:root { --text: #14161a; --muted: #5d636b; --line: #d5d8dc; --accent: #FF7A1A; --bg: #ffffff; --panel: #f4f5f6; }
* { box-sizing: border-box; }
body { margin: 0; background: var(--bg); color: var(--text); font: 13px/1.5 system-ui, "Segoe UI", Roboto, Helvetica, Arial, sans-serif; font-variant-numeric: tabular-nums; }
main { max-width: 960px; margin: 0 auto; padding: 24px 16px 48px; }
h1 { font-size: 22px; margin: 0 0 4px; }
h2 { font-size: 15px; font-weight: 600; margin: 32px 0 8px; padding-bottom: 4px; border-bottom: 2px solid var(--accent); }
h3 { font-size: 13px; font-weight: 600; margin: 16px 0 4px; }
table { border-collapse: collapse; width: 100%; margin: 8px 0; }
th, td { text-align: left; padding: 3px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
th { background: var(--panel); font-weight: 600; }
td.num, th.num { text-align: right; }
.muted { color: var(--muted); }
.chip { display: inline-block; padding: 1px 8px; border-radius: 6px; font-weight: 600; color: #0e1013; }
.PASS { background: #7BD88F; } .WARN { background: #FFD166; } .FAIL { background: #FF6B6B; } .SKIP { background: #d5d8dc; }
.bar { background: var(--panel); border: 1px solid var(--line); height: 10px; width: 160px; display: inline-block; vertical-align: middle; }
.bar i { display: block; height: 100%; background: var(--accent); }
.bar i.over { background: #FF6B6B; }
.grid4 { border-collapse: separate; border-spacing: 2px; width: auto; }
.grid4 td { border: 1px solid var(--line); text-align: center; min-width: 96px; padding: 4px 6px; }
.k0 { background: #cfe8d1; } .k1 { background: #e6e7b0; } .k2 { background: #f7e3a6; } .k3 { background: #f6cfa5; } .k4 { background: #efb1b1; }
blockquote { margin: 8px 0; padding: 8px 12px; border-left: 3px solid var(--accent); background: var(--panel); }
code { font-family: ui-monospace, Consolas, monospace; font-size: 12px; }
img { max-width: 100%; height: auto; }
@media print { main { padding: 0; } h2 { break-after: avoid; } table, .grid4 { break-inside: avoid; } .chip, .bar i, .grid4 td { -webkit-print-color-adjust: exact; print-color-adjust: exact; } }
</style>
</head>
<body>
<main>

<section id="header">
<h2>1. Header</h2>
<h1>Terrain Tile Pipeline Demo</h1>
<table>
<tr><th>Tile</th><td>{{ tile.name }} ({{ tile.tile_id }})</td></tr>
<tr><th>Generator version</th><td>{{ tile.generator }}</td></tr>
<tr><th>Git commit</th><td><code>{{ commit }}</code></td></tr>
<tr><th>Date</th><td>{{ retrieved_date }} (source retrieval date; the build records no date in this file)</td></tr>
<tr><th>Credit</th><td>{{ source.credit }}</td></tr>
</table>
</section>

<section id="verdict">
<h2>2. Verdict</h2>
<table>
<tr><th>Profile</th><th>Verdict</th><th class="num">Pass</th><th class="num">Warn</th><th class="num">Fail</th></tr>
{% for p in profiles %}
<tr><td>{{ p.name }}</td><td><span class="chip {{ p.chip }}">{{ p.chip }}</span></td><td class="num">{{ p.counts.pass }}</td><td class="num">{{ p.counts.warn }}</td><td class="num">{{ p.counts.fail }}</td></tr>
{% endfor %}
</table>
</section>

<section id="budgets">
<h2>3. Budgets</h2>
{% for p in profiles %}
<h3>{{ p.name }}</h3>
<table>
<tr><th>Item</th><th class="num">Used</th><th class="num">Max</th><th class="num">Percent</th><th></th></tr>
{% for b in p.budgets %}
<tr><td>{{ b.label }}{% if b.tag %} <span class="muted">[{{ b.tag }}]</span>{% endif %}</td><td class="num">{{ b.used | n }}</td><td class="num">{{ b.max | n }}</td><td class="num">{{ b.pct | f(1) }}%</td><td><span class="bar"><i{% if b.pct > 100 %} class="over"{% endif %} style="width: {{ [b.pct, 100] | min | f(1) }}%"></i></span></td></tr>
{% endfor %}
</table>
<p class="muted">Budget anchor: {{ p.anchor }}. Items tagged ASSUMED rest on an assumed input; the other limits are the anchor times the content share.</p>
{% endfor %}
</section>

<section id="lod-selection">
<h2>4. LOD selection</h2>
{% for p in profiles %}
<h3>{{ p.name }} (north up)</h3>
<table class="grid4">
{% for row in p.cells %}
<tr>{% for c in row %}<td class="k{{ c.k }}">LOD {{ c.k }}<br><span class="muted">e_max {{ c.e | f(2) }} m</span></td>{% endfor %}</tr>
{% endfor %}
</table>
<table>
<tr><th>tau</th><td>{{ p.e.tau_target_m | f(3) }} m</td></tr>
<tr><th>e_star</th><td>{{ p.e.e_star_m | f(3) }} m</td></tr>
<tr><th>Pixel error at V = 1.5</th><td>{{ p.e.error_px_nominal | f(2) }} px</td></tr>
<tr><th>Pixel error at V = 3.0</th><td>{{ p.e.error_px_v3 | f(2) }} px</td></tr>
</table>
<p>{{ p.sentence }}</p>
{% endfor %}
</section>

<section id="lod-errors">
<h2>5. LOD error table</h2>
<p class="muted">e_max in meters.</p>
<table>
<tr><th>Chunk</th>{% for k in lods %}<th class="num">LOD {{ k }}</th>{% endfor %}</tr>
{% for cid in chunk_ids %}
<tr><td>{{ cid }}</td>{% for e in lod_err[cid] %}<td class="num">{{ e | f(3) }}</td>{% endfor %}</tr>
{% endfor %}
</table>
</section>

<section id="rules">
<h2>6. Rules</h2>
<p class="muted">Grouped by scope. Failures first, then warnings, then passes, then skips.</p>
{% for g in groups %}
<h3>{{ g.scope }}</h3>
<table>
{% for r in g.rows %}
<tr{% if r.status in ("PASS", "SKIP") %} class="muted"{% endif %}><td><span class="chip {{ r.status }}">{{ r.status }}</span></td><td>{{ r.rule }}</td><td>{{ r.message }}{% if r.status in ("FAIL", "WARN") and r.fix_hint %} <em>{{ r.fix_hint }}</em>{% endif %}</td></tr>
{% endfor %}
</table>
{% endfor %}
</section>

<section id="entities">
<h2>7. Entities</h2>
<table>
<tr><th>Entity</th>{% for k in lods[:3] %}<th class="num">LOD {{ k }} tris / limit</th>{% endfor %}<th>Source gate</th><th>Export gate</th></tr>
{% for e in entities %}
<tr><td>{{ e.id }}</td>{% for l in e.lods %}<td class="num">{{ l.tris | n }} / {{ l.max | n }}</td>{% endfor %}<td><span class="chip {{ e.source }}">{{ e.source }}</span></td><td><span class="chip {{ e.export }}">{{ e.export }}</span></td></tr>
{% endfor %}
</table>
{% if h5 %}<p><img alt="Entities seen from 0.4 m (H5)" src="{{ h5 }}"></p>{% else %}<p class="muted">Hero image H5 is not present.</p>{% endif %}
</section>

<section id="fixtures">
<h2>8. Fixture matrix</h2>
<table>
<tr><th>Fixture</th><th>Expected failing rules</th><th>Actual failing rules</th><th>Match</th></tr>
{% for f in fixtures %}
<tr><td>{{ f.id }}</td><td>{{ f.expected | join(", ") }}</td><td>{{ f.actual | join(", ") or "none" }}</td><td>{% if not f.ran %}<span class="chip SKIP">SKIP</span>{% elif f.expected == f.actual %}<span class="chip PASS">PASS</span>{% else %}<span class="chip FAIL">FAIL</span>{% endif %}</td></tr>
{% endfor %}
</table>
</section>

<section id="registration">
<h2>9. Registration and accuracy</h2>
<table>
{% for r in geo %}
<tr><td>{{ r.scope }}</td><td><span class="chip {{ r.status }}">{{ r.status }}</span></td><td>{{ r.message }}</td></tr>
{% endfor %}
</table>
<blockquote>{{ accuracy }}</blockquote>
</section>

<section id="scale">
<h2>10. Scale estimate</h2>
<table>
<tr><th>Stage</th><th class="num">Measured seconds</th></tr>
{% for s, v in scale.stages %}
<tr><td>{{ s }}</td><td class="num">{{ v | f(2) }}</td></tr>
{% endfor %}
<tr><th>Total</th><th class="num">{{ scale.total | f(2) }}</th></tr>
</table>
<p>Bytes per tile: {{ scale.bytes | n }} (all files in the tile output folder except the validation file and the hash list).</p>
<table>
<tr><th class="num">Tiles</th><th class="num">Seconds</th><th class="num">Bytes</th></tr>
{% for r in scale.rows %}
<tr><td class="num">{{ r.n | n }}</td><td class="num">{{ r.seconds | f(1) }}</td><td class="num">{{ r.bytes | n }}</td></tr>
{% endfor %}
</table>
<p>{{ extrapolation }}</p>
</section>

<section id="provenance">
<h2>11. Provenance</h2>
<table>
<tr><th>Source product</th><td>{{ source.product }}</td></tr>
{% for u in source.urls %}<tr><th>Source URL</th><td>{{ u }}</td></tr>{% endfor %}
<tr><th>Crop SHA-256</th><td><code>{{ source.crop_sha256 }}</code></td></tr>
<tr><th>Retrieved</th><td>{{ retrieved_date }}</td></tr>
{% for n, v in versions %}<tr><th>{{ n }}</th><td>{{ v }}</td></tr>{% endfor %}
<tr><th>Validator</th><td>{{ validator }}</td></tr>
</table>
<p>{{ static_only }}</p>
</section>

<section id="assumptions">
<h2>12. Assumptions</h2>
{% for p in profiles %}
<h3>{{ p.name }}</h3>
<table>
<tr><th>Field</th><th>Value</th><th>Description</th></tr>
{% for a in p.assumed %}
<tr><td><code>{{ a.field }}</code></td><td>{{ a.value }}</td><td>{{ a.desc }}</td></tr>
{% endfor %}
</table>
{% endfor %}
</section>

</main>
</body>
</html>
