{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aois.schema.json",
  "title": "aois.toml (SPEC 5.2)",
  "type": "object",
  "minProperties": 1,
  "patternProperties": {
    "^[a-z][a-z0-9]*(_[a-z0-9]+)*_[0-9]{2}$": {"$ref": "#/$defs/aoi"}
  },
  "additionalProperties": false,
  "$defs": {
    "range": {
      "type": "array",
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "aoi": {
      "type": "object",
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "center_lat": {"type": "number", "minimum": 0, "maximum": 84},
        "center_lon": {"type": "number", "minimum": -180, "maximum": 180},
        "min_relief_m": {"type": "number", "exclusiveMinimum": 0},
        "expect_e0_range": {"$ref": "#/$defs/range"},
        "expect_n0_range": {"$ref": "#/$defs/range"}
      },
      "required": ["name", "center_lat", "center_lon", "min_relief_m", "expect_e0_range", "expect_n0_range"],
      "additionalProperties": false
    }
  }
}
